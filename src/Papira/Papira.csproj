<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RootNamespace>Papira</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Self-describing fluent methods (Bold, PaddingLeft, ...) don't need XML docs. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <PropertyGroup Label="Package">
    <PackageId>Papira</PackageId>
    <Version>1.4.2</Version>
    <Authors>Mert Gundogan</Authors>
    <Copyright>Copyright (c) 2026 Mert Gundogan</Copyright>
    <Description>Fast, free, dependency-free PDF generation for .NET — from C# or from the HTML templates you already have. Fluent layout with automatic pagination and tables; HTML and CSS templates with flexbox, grid and style sheets, laid out within a point of what a browser prints; PDF/A archiving and PDF/UA accessible output; fillable forms; digital signatures; AES-256 encryption; QR codes and barcodes; SVG; images; right-to-left, Indic and colour-emoji text. No browser, no native libraries, no third-party packages. Trimming and Native AOT compatible. MIT licensed, commercial use included.</Description>
    <PackageTags>pdf;pdf-generation;pdf-library;html-to-pdf;html;css;report;reporting;invoice;document;layout;fluent;pdfa;pdf-ua;accessibility;forms;signature;encryption;qrcode;barcode;svg;unicode;rtl;aot;nativeaot;trimming</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/mertgundoganx/Papira</PackageProjectUrl>
    <RepositoryUrl>https://github.com/mertgundoganx/Papira</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReleaseNotes>https://github.com/mertgundoganx/Papira/blob/main/CHANGELOG.md</PackageReleaseNotes>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EnablePackageValidation>true</EnablePackageValidation>
    <!--
      Fails the build if the public API is no longer compatible with the first release of this major
      line. A version just published is not restorable for a few minutes, so the baseline is the oldest
      version 1.x promises to keep working with rather than the newest one.
    -->
    <PackageValidationBaselineVersion>1.0.0</PackageValidationBaselineVersion>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\Fonts\*.ttf" LogicalName="Papira.Fonts.%(Filename)%(Extension)" />
    <None Include="Resources\Fonts\OFL.txt" Pack="true" PackagePath="licenses\Lato-OFL.txt" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\assets\icon.png" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
    <None Include="..\..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Papira.Tests" />
  </ItemGroup>

</Project>
