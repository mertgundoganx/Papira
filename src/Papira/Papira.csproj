<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RootNamespace>Papira</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Self-describing fluent methods (Bold, PaddingLeft, ...) don't need XML docs. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <PropertyGroup Label="Package">
    <PackageId>Papira</PackageId>
    <Version>0.1.0</Version>
    <Authors>Mert Gundogan</Authors>
    <Copyright>Copyright (c) 2026 Mert Gundogan</Copyright>
    <Description>Fast, free, dependency-free PDF generation for .NET. Fluent layout API with automatic pagination, tables, TrueType font embedding with subsetting, PNG/JPEG images and a multi-core output pipeline. No browser, no native libraries.</Description>
    <PackageTags>pdf;pdf-generation;pdf-library;report;invoice;document;layout;fluent</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/mertgundoganx/Papira</PackageProjectUrl>
    <RepositoryUrl>https://github.com/mertgundoganx/Papira</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReleaseNotes>https://github.com/mertgundoganx/Papira/blob/main/CHANGELOG.md</PackageReleaseNotes>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EnablePackageValidation>true</EnablePackageValidation>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\Fonts\*.ttf" LogicalName="Papira.Fonts.%(Filename)%(Extension)" />
    <None Include="Resources\Fonts\OFL.txt" Pack="true" PackagePath="licenses\Lato-OFL.txt" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\assets\icon.png" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
    <None Include="..\..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Papira.Tests" />
  </ItemGroup>

</Project>
